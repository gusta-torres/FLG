# LLM Provider: "mock" | "openai" | "anthropic" | "deepseek"
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# DeepSeek (API compatível com OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database
DATABASE_URL=sqlite+aiosqlite:///./flg.db

# CORS (apenas necessário se o frontend chamar a API diretamente; com o proxy do Next, pode ficar vazio)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Autenticação (JWT) — use um segredo longo e aleatório em produção
JWT_SECRET=dev-insecure-secret-change-me-in-production-0123456789
JWT_EXPIRE_MINUTES=480

# Usuário de marketing inicial (criado no primeiro start)
ADMIN_EMAIL=admin@flg.local
ADMIN_PASSWORD=flg-admin-123
ADMIN_NAME=Equipe de Marketing

# App
APP_ENV=development
